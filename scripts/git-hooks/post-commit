#!/usr/bin/env bash
# post-commit: a local commit never deploys.
#
# Until 2026-11 this hook reinstalled the `mem` uv tool whenever a commit
# touched src/, pyproject.toml or uv.lock. That tied deployment to committing
# and could replace a runtime that a release selector (.pth) had deliberately
# pinned, flipping bare `mem` to the worktree and breaking a wrapper that
# verifies the selector. Deployment now belongs to the explicit staged release
# tool (scripts/release.py, documented in RELEASE.md). This hook only reports,
# in one line, what the `mem` on PATH would import right now, so a stale
# deployment is visible at the moment source changes. It installs nothing.
set -u

if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^(src/|pyproject\.toml$|uv\.lock$)'; then
    exit 0
fi

if command -v mem >/dev/null 2>&1; then
    runtime="$(timeout 5 mem --version 2>/dev/null || echo 'mem --version unavailable')"
else
    runtime="no mem on PATH"
fi
echo "post-commit: source changed; NOT deployed (a commit never installs). On PATH now: ${runtime}. Deploy deliberately: scripts/release.py (see RELEASE.md)."
exit 0
