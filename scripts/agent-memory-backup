#!/bin/bash
# agent-memory-backup: bundle the KB git repo to the Windows-side backup dir,
# and sync the Windows-native Obsidian viewing mirror.
# Machine-specific ops tooling (Brent's WSL2 box), not part of the mem product.
#
# The bundle carries the FULL git history; restore with:
#   git clone /mnt/c/Users/bgibs/Backups/agent-memory/agent-memory-latest.bundle ~/.agent-memory
#   mem reindex   # indexes are derived, never backed up
# Confidentiality: destination is this machine's own disk - the KB never leaves localhost.
#
# Deploy wiring (already live; reproduce on a fresh machine with):
#   ln -sf <repo>/scripts/agent-memory-backup ~/.local/bin/agent-memory-backup
#   crontab: @reboot sleep 60 && $HOME/.local/bin/agent-memory-backup >> $HOME/.local/state/agent-memory-backup.log 2>&1
#            0 12 * * *          $HOME/.local/bin/agent-memory-backup >> $HOME/.local/state/agent-memory-backup.log 2>&1
set -euo pipefail

# --heal-mirror: when the mirror has drifted dirty (a viewer is never meant to
# hold edits, but reset --hard can be interrupted, leaving it stuck), discard the
# mirror's working-tree state and resync to canonical. Deliberate + attended only:
# unattended runs FAIL LOUD instead, so a silent skip can never masquerade as
# success (that masking is exactly what let the mirror lag ~a day undetected).
HEAL_MIRROR=0
[ "${1:-}" = "--heal-mirror" ] && HEAL_MIRROR=1

KB="$HOME/.agent-memory"
DEST="/mnt/c/Users/bgibs/Backups/agent-memory"
mkdir -p "$DEST"

# Sweep external edits (e.g. Obsidian) into a commit so the bundle captures them.
# Under the KB's write lock: `mem save` serializes write+commit under this same
# flock, and an unattended `git add -A` racing a live save could commit a
# .tmp mid-rename or fail the save's own commit on index.lock contention.
exec 9>"$KB/.index/write.lock"
flock 9
if [ -n "$(git -C "$KB" status --porcelain)" ]; then
    git -C "$KB" add -A
    git -C "$KB" commit -q -m "backup sweep: external edits"
fi

TMP="$DEST/.bundle.tmp"
git -C "$KB" bundle create "$TMP" --all
git -C "$KB" bundle verify "$TMP" > /dev/null 2>&1
flock -u 9

cp "$TMP" "$DEST/agent-memory-$(date +%a).bundle"   # 7-generation weekday ring
mv "$TMP" "$DEST/agent-memory-latest.bundle"

# Windows-native read-only mirror for Obsidian (C:\Users\bgibs\agent-memory-view).
# One-way WSL -> Windows; MUST stay out of OneDrive-synced folders (confidentiality).
# Edits belong in the canonical KB - a dirty mirror is surfaced and skipped, never clobbered.
MIRROR="/mnt/c/Users/bgibs/agent-memory-view"
mirror_failed=0
if [ ! -d "$MIRROR/.git" ]; then
    git clone -q "$KB" "$MIRROR"
elif [ -n "$(git -C "$MIRROR" status --porcelain)" ]; then
    if [ "$HEAL_MIRROR" = 1 ]; then
        # Attended recovery: an untracked file is content the mirror holds and
        # canonical does not - refuse even with --heal, it could be the one thing
        # worth keeping. Only tracked-file drift is safe to discard (canonical is
        # the source of truth and bundle-backed).
        if [ -n "$(git -C "$MIRROR" status --porcelain | grep '^??' || true)" ]; then
            echo "agent-memory-backup: ERROR - mirror has UNTRACKED files; --heal-mirror refuses" \
                 "to delete them. Inspect: git -C $MIRROR status" >&2
            git -C "$MIRROR" status --porcelain | grep '^??' >&2
            mirror_failed=1
        else
            git -C "$MIRROR" checkout -q .
            git -C "$MIRROR" clean -fdq
            git -C "$MIRROR" fetch -q origin
            git -C "$MIRROR" reset -q --hard origin/main
            echo "agent-memory-backup: mirror HEALED - discarded tracked-file drift, resynced to canonical"
        fi
    else
        echo "agent-memory-backup: ERROR - mirror at $MIRROR is dirty; sync SKIPPED and NOT current." >&2
        echo "  The mirror is a read-only viewer; drift is usually an interrupted resync, not your edits." >&2
        echo "  Recover (attended): agent-memory-backup --heal-mirror" >&2
        echo "  Dirty paths:" >&2
        git -C "$MIRROR" status --porcelain | head -5 >&2
        mirror_failed=1
    fi
else
    git -C "$MIRROR" fetch -q origin
    git -C "$MIRROR" reset -q --hard origin/main
fi

echo "agent-memory-backup: $(date -u +%FT%TZ) -> $DEST ($(git -C "$KB" rev-parse --short HEAD))"
if [ "$mirror_failed" = 1 ]; then
    echo "agent-memory-backup: bundle OK, but MIRROR SYNC FAILED (see errors above)" >&2
    exit 1
fi
